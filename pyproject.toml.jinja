[project]
name = "{{project_name}}"
version = "0.1.0"
description = "{{ project_description }}"
license = { text = "MIT" }
readme = "README.md"
authors = [
    { name = "{{author}}", email = "{{email}}" },
]
requires-python = ">=3.11"
dependencies = []

[dependency-groups]
lint = [
    "ruff >= 0.17",
]
type = ["mypy >= 2.4"]
test = ["pytest >= 9.1", "coverage >= 7.16", "pytest-cov ~= 7.1"]
doc = [
    "mkdocs == 1.6.1",
    "mkdocs-material == 9.7.7",
    "mkdocstrings[python] == 1.0.7",
]
dev = [
    {include-group = "lint"},
    {include-group = "type"},
    {include-group = "test"},
    {include-group = "doc"},
    "pre-commit >= 4.6",
    "ipykernel >= 7.4",
]

[tool.setuptools.packages.find]
where = ["src"]
exclude = ["material"]

[tool.ruff]
line-length = 100
extend-include = ["*.ipynb"]

[tool.ruff.lint]
select = ["E4", "E7", "E9", "W", "F", "B", "D", "I", "S"]
ignore = ["D203", "D213", "S101"]
unfixable = ["B", "S"]
pydocstyle.convention = "google"

[tool.mypy]
ignore_missing_imports = true

[build-system]
requires = ["setuptools", "setuptools-scm"]
build-backend = "setuptools.build_meta"
